user -> browser "Formuliert Auftrag, bestätigt Freigaben"
browser -> bridge "Prompts und UI-Ereignisse" "Lokale HTTP/WebSocket-Brücke (Anwendungsdesign)"
bridge -> agentA "Startet und steuert Sitzung" "ACP / JSON-RPC über stdio"
bridge -> agentB "Optional: Folgeauftrag mit Ergebnis von A" "ACP / separate Sitzung"
agentA -> llm "Fragt Modell an" "Provider-API"
agentB -> llm "Fragt Modell an" "Provider-API"
bridge -> files "Dateien lesen/schreiben nach Fähigkeiten und Freigabe"
bridge -> remote "Optional: delegiert Aufgabe" "A2A über passenden Client/Adapter"
browser -> ui "Sendet Auftrag"
ui -> router "Übergibt Prompt und Kontext"
router -> acp "1. Verbindung initialisieren / Sitzung anlegen"
acp -> permissions "2. Werkzeug- oder Freigabeanfrage bearbeiten"
permissions -> acp "3. Ergebnis / Entscheidung zurückgeben"
acp -> router "4. Updates und Abschluss weiterreichen"
router -> ui "5. Ergebnis anzeigen oder nächste Sitzung starten"
acp -> agentA "Steuert Agent A" "ACP"
acp -> agentB "Steuert Agent B" "ACP"
permissions -> files "Erlaubte Dateioperationen"
